# =============================================================================
# Transport app — environment variable map
# =============================================================================
#
# BACKEND (runtime)     → transport/backend/.env
# FRONTEND (build time) → transport/frontend/.env.local  (dev)
#                       → docker-compose build args     (production)
# DOCKER COMPOSE        → project root .env             (see below)
#
# =============================================================================

# ── Project root .env (docker compose only) ──────────────────────────────────
# Create /root/hostel-booking-app/.env with these if not present:
#
# TRANSPORT_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# TRANSPORT_ADMIN_EMAIL=admin@rajalakshmi.org
#
# docker-compose.yml passes them into transport_frontend at build time.

# ── Backend variables (transport/backend/.env) ─────────────────────────────
# DJANGO_SECRET_KEY          JWT signing / Django crypto
# DJANGO_DEBUG               True=local only; False=production (enables Redis cache)
# POSTGRES_DB                Must be transport_db (not rec_hostel_db)
# POSTGRES_USER
# POSTGRES_PASSWORD
# POSTGRES_HOST              db (Docker service name)
# POSTGRES_PORT
# ALLOWED_HOSTS              Comma-separated; include transport_backend for Docker
# CORS_ALLOWED_ORIGINS       https://transport.rajalakshmi.org
# CSRF_TRUSTED_ORIGINS       Frontend + backend URLs
# CACHE_REDIS_URL            redis://redis:6379/3
# PORTAL_ADMIN_USERNAME        Django superuser username
# PORTAL_ADMIN_EMAIL         Portal + Django admin email
# PORTAL_ADMIN_PASSWORD      Required for create_admin.py
# PORTAL_STUDENT_PASSWORD    Legacy; unused in code
# ZEPTOMAIL_SMTP_HOST
# ZEPTOMAIL_SMTP_PORT
# ZEPTOMAIL_SMTP_USE_TLS
# EMAIL_HOST_USER
# EMAIL_HOST_PASSWORD
# FROM_EMAIL
# FROM_NAME                  e.g. REC Transport

# ── Frontend variables (build-time, NEXT_PUBLIC_* ) ──────────────────────────
# NEXT_PUBLIC_API_URL        https://transportbackend.rajalakshmi.org
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY   Maps on /form
# NEXT_PUBLIC_ADMIN_EMAIL    Blocks admin email on student login page
